// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int      @id @default(autoincrement())
  githubId           String   @unique
  username           String
  avatarUrl          String?
  githubToken        String? // Encrypted GitHub Access Token
  hashedRefreshToken String? // Hashed Refresh Token
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  availableTokens    Int      @default(100000)

  stats        UserStat?
  repositories Repository[]
  reports      AnalysisReport[]

  representativeReportId Int?            @unique
  representativeReport   AnalysisReport? @relation("RepresentativeReport", fields: [representativeReportId], references: [id])

  @@map("users")
}

model UserStat {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  mutualRespectScore      Float @default(0)
  conflictManagementScore Float @default(0)
  logicalProblemScore     Float @default(0)
  reviewGuidingScore      Float @default(0)
  documentationScore      Float @default(0)
  knowledgeSharingScore   Float @default(0)
  technicalInfluenceScore Float @default(0)
  codeStabilityScore      Float @default(0)

  updatedAt DateTime @updatedAt

  @@map("user_stats")
}

model Repository {
  id           Int       @id @default(autoincrement())
  githubRepoId String    @unique
  fullName     String
  isOptedIn    Boolean   @default(false)
  lastSyncTime DateTime?

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  reports AnalysisReport[]

  @@map("repositories")
}

model AnalysisReport {
  id       Int      @id @default(autoincrement())
  syncTime DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  repositoryId Int
  repository   Repository @relation(fields: [repositoryId], references: [id])

  metrics Json? // Stores detailed analysis data from LLM

  isShared      Boolean @default(false)
  representedBy User?   @relation("RepresentativeReport")

  @@map("analysis_reports")
}

