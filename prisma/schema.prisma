// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int      @id @default(autoincrement())
  githubId           String   @unique
  username           String
  avatarUrl          String?
  githubToken        String? // Encrypted GitHub Access Token
  hashedRefreshToken String? // Hashed Refresh Token
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  availableTokens    Int      @default(100000)

  stats                  UserStat?
  repositories           Repository[]
  reports                AnalysisReport[]
  githubInstallations    UserGithubInstallation[]
  githubAppInstallStates GithubAppInstallState[]

  representativeReportId Int?            @unique
  representativeReport   AnalysisReport? @relation("RepresentativeReport", fields: [representativeReportId], references: [id])

  @@map("users")
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum GithubInstallationAccountType {
  USER
  ORGANIZATION
}

enum GithubInstallationStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum GithubInstallationLinkSource {
  INSTALL_CALLBACK
  AUTO_DISCOVERY
}

model GithubInstallation {
  id                   Int                           @id @default(autoincrement())
  githubInstallationId String                        @unique
  accountId            String
  accountLogin         String
  accountType          GithubInstallationAccountType
  repositorySelection  String
  status               GithubInstallationStatus      @default(ACTIVE)
  suspendedAt          DateTime?
  deletedAt            DateTime?
  githubCreatedAt      DateTime?
  githubUpdatedAt      DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  users UserGithubInstallation[]

  @@index([accountType, accountLogin])
  @@map("github_installations")
}

model UserGithubInstallation {
  userId               Int
  installationId       Int
  source               GithubInstallationLinkSource
  membershipVerifiedAt DateTime
  linkedAt             DateTime                     @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@id([userId, installationId])
  @@index([installationId])
  @@map("user_github_installations")
}

model GithubAppInstallState {
  id         String    @id @default(uuid())
  userId     Int
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("github_app_install_states")
}

model UserStat {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  mutualRespectScore      Float @default(0)
  conflictManagementScore Float @default(0)
  logicalProblemScore     Float @default(0)
  reviewGuidingScore      Float @default(0)
  documentationScore      Float @default(0)
  knowledgeSharingScore   Float @default(0)
  technicalInfluenceScore Float @default(0)
  codeStabilityScore      Float @default(0)

  updatedAt DateTime @updatedAt

  @@map("user_stats")
}

model Repository {
  id           Int       @id @default(autoincrement())
  githubRepoId String    @unique
  fullName     String
  isOptedIn    Boolean   @default(false)
  lastSyncTime DateTime?

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  reports AnalysisReport[]

  @@map("repositories")
}

model AnalysisReport {
  id       Int      @id @default(autoincrement())
  syncTime DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  repositoryId Int
  repository   Repository @relation(fields: [repositoryId], references: [id])

  metrics Json? // Stores detailed analysis data from LLM

  isShared      Boolean @default(false)
  representedBy User?   @relation("RepresentativeReport")

  @@map("analysis_reports")
}
